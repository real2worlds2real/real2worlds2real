{
  "name": "native_cloth_proposal",
  "input": {
    "type": "object",
    "properties": {
      "session": {"type": "string", "minLength": 1},
      "object": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
      "link": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
      "anchor": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
      "candidate": {"type": "string", "minLength": 1},
      "probe": {"type": "string", "minLength": 1},
      "mode": {"enum": ["released_candidate", "preparation_seed", "geometry_seed"]},
      "time_s": {"type": "number", "minimum": 0}
    },
    "required": ["session", "object", "link", "anchor", "candidate", "probe"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {"const": true},
      "proposal_only": {"const": true},
      "requires_agent_rebuild": {"const": true},
      "authored_ok": {"type": "boolean"},
      "source_pose_approved": {"const": false},
      "native_approved": {"const": false},
      "task_approved": {"const": false},
      "candidate": {"type": "string"},
      "evidence_images": {"type": "array", "items": {"type": "string"}}
    },
    "required": ["ok", "proposal_only", "requires_agent_rebuild", "authored_ok", "source_pose_approved", "native_approved", "task_approved", "candidate", "evidence_images"],
    "additionalProperties": true
  }
}
