{
  "name": "export",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "session": {
        "type": "string",
        "minLength": 1
      },
      "object": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "round": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "session",
      "object",
      "round"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "required": [
      "ok",
      "evidence_images"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "evidence_images": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Evidence paths relative to the repository root (absolute for outputs outside it)"
      },
      "mesh": {
        "type": "string"
      },
      "geometry": {
        "type": "object"
      },
      "sdf": {
        "type": "object",
        "description": "SDF 256; 2 mm contact offset. Physics cooking verified by task_check."
      }
    },
    "additionalProperties": true
  }
}
