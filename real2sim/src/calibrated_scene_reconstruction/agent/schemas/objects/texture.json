{
  "name": "texture",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "session": {
        "type": "string",
        "minLength": 1
      },
      "object": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "resolution": {
        "type": "integer",
        "minimum": 64,
        "maximum": 2048
      }
    },
    "required": [
      "session",
      "object"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "required": [
      "ok",
      "evidence_images"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "evidence_images": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Evidence paths relative to the repository root (absolute for outputs outside it)"
      },
      "mesh": {
        "type": "string"
      },
      "albedo": {
        "type": "string"
      },
      "seen": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "sheet": {
        "type": "string"
      }
    },
    "additionalProperties": true
  }
}
