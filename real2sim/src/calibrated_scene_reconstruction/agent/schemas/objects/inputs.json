{
  "name": "inputs",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "session": {"type": "string", "minLength": 1},
      "object": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
    },
    "required": ["session"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "required": ["ok", "evidence_images", "uses", "supplemental_evidence"],
    "properties": {
      "ok": {"type": "boolean"},
      "evidence_images": {"type": "array", "items": {"type": "string"}},
      "uses": {"type": "array", "items": {"type": "object"}},
      "supplemental_evidence": {"type": ["object", "null"]}
    },
    "additionalProperties": true
  }
}
